"page":144,"line":0,"x0":248.11,"x1":291.05,"paths":[]},{"n":25,"text":"عَلَى","page":144,"line":0,"x0":279.21,"x1":299.13,"paths":[]},{"n":26,"text":"ٱلَّذِينَ","page":144,"line":0,"x0":260.1,"x1":295.39,"paths":[]},{"n":27,"text":"لَا","page":144,"line":0,"x0":316.12,"x1":328.15,"paths":[]},{"n":28,"text":"يُؤْمِنُونَ","page":144,"line":0,"x0":273.78,"x1":332.25,"paths":[]}],"mark":{"page":144,"line":0,"x0":238.33,"x1":256.64,"paths":[]},"phrases":[{"from":1,"to":5,"text":{"id":"Maka, siapa yang Allah kehendaki mendapat hidayah"}},{"from":6,"to":8,"text":{"id":"Dia akan melapangkan dadanya untuk menerima Islam"}},{"from":9,"to":12,"text":{"id":"Siapa yang Dia kehendaki menjadi sesat"}},{"from":13,"to":16,"text":{"id":"Dia akan menjadikan dadanya sempit lagi sesak"}},{"from":17,"to":20,"text":{"id":"seakan-akan dia sedang mendaki ke langit"}},{"from":21,"to":28,"text":{"id":"Begitulah Allah menimpakan siksa kepada orang-orang yang tidak beriman"}}],"full":{"id":"Maka, siapa yang Allah kehendaki mendapat hidayah, Dia akan melapangkan dadanya untuk menerima Islam. Siapa yang Dia kehendaki menjadi sesat, Dia akan menjadikan dadanya sempit lagi sesak seakan-akan dia sedang mendaki ke langit. Begitulah Allah menimpakan siksa kepada orang-orang yang tidak beriman."},"source":"kemenag-2019-adapted","reviewed":false}