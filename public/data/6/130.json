aths":[]},{"n":24,"text":"أَنفُسِهِمْ","page":144,"line":0,"x0":270.81,"x1":328.46,"paths":[]},{"n":25,"text":"أَنَّهُمْ","page":144,"line":0,"x0":296.32,"x1":328.69,"paths":[]},{"n":26,"text":"كَانُوا۟","page":144,"line":0,"x0":327.48,"x1":375.94,"paths":[]},{"n":27,"text":"كَٰفِرِينَ","page":144,"line":0,"x0":280.03,"x1":349.02,"paths":[]}],"mark":{"page":144,"line":0,"x0":4.16,"x1":22.46,"paths":[]},"phrases":[{"from":1,"to":3,"text":{"id":"(Allah berfirman,) Wahai golongan jin dan manusia"}},{"from":4,"to":7,"text":{"id":"tidakkah sudah datang kepadamu rasul-rasul dari kalanganmu sendiri"}},{"from":8,"to":10,"text":{"id":"yang menyampaikan ayat-ayat-Ku kepadamu"}},{"from":11,"to":14,"text":{"id":"dan memperingatkanmu tentang pertemuan pada hari ini?"}},{"from":15,"to":18,"text":{"id":"Mereka menjawab, (Ya,) kami menjadi saksi atas diri kami sendiri"}},{"from":19,"to":21,"text":{"id":"Namun, mereka tertipu oleh kehidupan dunia"}},{"from":22,"to":27,"text":{"id":"Mereka telah menjadi saksi atas diri mereka sendiri bahwa mereka adalah orang kafir"}}],"full":{"id":"(Allah berfirman,) “Wahai golongan jin dan manusia, tidakkah sudah datang kepadamu rasul-rasul dari kalanganmu sendiri yang menyampaikan ayat-ayat-Ku kepadamu dan memperingatkanmu tentang pertemuan pada hari ini?” Mereka menjawab, “(Ya,) kami menjadi saksi atas diri kami sendiri.” Namun, mereka tertipu oleh kehidupan dunia. Mereka telah menjadi saksi atas diri mereka sendiri bahwa mereka adalah orang kafir."},"source":"kemenag-2019-adapted","reviewed":false}