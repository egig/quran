{"version":5,"key":"6:128","surah":6,"ayah":128,"surahName":{"ar":"الأنعام","latin":"Al-Anʿām"},"words":[{"n":1,"text":"وَيَوْمَ","page":144,"line":0,"x0":312.64,"x1":338.96,"paths":[]},{"n":2,"text":"يَحْشُرُهُمْ","page":144,"line":0,"x0":306.48,"x1":358.93,"paths":[]},{"n":3,"text":"جَمِيعࣰا","page":144,"line":0,"x0":292.96,"x1":328.14,"paths":[]},{"n":4,"text":"يَٰمَعْشَرَ","page":144,"line":0,"x0":271.41,"x1":323.1,"paths":[]},{"n":5,"text":"ٱلْجِنِّ","page":144,"line":0,"x0":269.73,"x1":303.63,"paths":[]},{"n":6,"text":"قَدِ","page":144,"line":0,"x0":281.15,"x1":295.14,"paths":[]},{"n":7,"text":"ٱسْتَكْثَرْتُم","page":144,"line":0,"x0":203.34,"x1":295.27,"paths":[]},{"n":8,"text":"مِّنَ","page":144,"line":0,"x0":278.46,"x1":295.4,"paths":[]},{"n":9,"text":"ٱلْإِنسِۖ","page":144,"line":0,"x0":264.75,"x1":303.03,"paths":[]},{"n":10,"text":"وَقَالَ","page":144,"line":0,"x0":284.96,"x1":311.39,"paths":[]},{"n":11,"text":"أَوْلِيَآؤُهُم","page":144,"line":0,"x0":264.31,"x1":328.15,"paths":[]},{"n":12,"text":"مِّنَ","page":144,"line":0,"x0":320.54,"x1":337.95,"paths":[]},{"n":13,"text":"ٱلْإِنسِ","page":144,"line":0,"x0":299.48,"x1":337.89,"paths":[]},{"n":14,"text":"رَبَّنَا","page":144,"line":0,"x0":318.11,"x1":342.51,"paths":[]},{"n":15,"text":"ٱسْتَمْتَعَ","page":144,"line":0,"x0":275.65,"x1":329.38,"paths":[]},{"n":16,"text":"بَعْضُنَا","page":144,"line":0,"x0":309.76,"x1":347.93,"paths":[]},{"n":17,"text":"بِبَعْضࣲ","page":144,"line":0,"x0":293.11,"x1":334.45,"paths":[]},{"n":18,"text":"وَبَلَغْنَآ","page":144,"line":0,"x0":320.93,"x1":356.69,"paths":[]},{"n":19,"text":"أَجَلَنَا","page":144,"line":0,"x0":289.78,"x1":328.15,"paths":[]},{"n":20,"text":"ٱلَّذِىٓ","page":144,"line":0,"x0":304.26,"x1":334.05,"paths":[]},{"n":21,"text":"أَجَّلْتَ","page":144,"line":0,"x0":293.81,"x1":328.84,"paths":[]},{"n":22,"text":"لَنَاۚ","page":144,"line":0,"x0":308.84,"x1":328.18,"paths":[]},{"n":23,"text":"قَالَ","page":144,"line":0,"x0":319.48,"x1":338.68,"paths":[]},{"n":24,"text":"ٱلنَّارُ","page":144,"line":0,"x0":297.38,"x1":329.4,"paths":[]},{"n":25,"text":"مَثْوَىٰكُمْ","page":144,"line":0,"x0":310.92,"x1":379.85,"paths":[]},{"n":26,"text":"خَٰلِدِينَ","page":144,"line":0,"x0":293.43,"x1":335.63,"paths":[]},{"n":27,"text":"فِيهَآ","page":144,"line":0,"x0":321.07,"x1":347.18,"paths":[]},{"n":28,"text":"إِلَّا","page":144,"line":0,"x0":310.03,"x1":328.14,"paths":[]},{"n":29,"text":"مَا","page":144,"line":0,"x0":321.16,"x1":333.49,"paths":[]},{"n":30,"text":"شَآءَ","page":144,"line":0,"x0":310.52,"x1":339.47,"paths":[]},{"n":31,"text":"ٱللَّهُۚ","page":144,"line":0,"x0":303.52,"x1":323.35,"paths":[]},{"n":32,"text":"إِنَّ","page":144,"line":0,"x0":313.83,"x1":330.89,"paths":[]},{"n":33,"text":"رَبَّكَ","page":144,"line":0,"x0":303.47,"x1":330.76,"paths":[]},{"n":34,"text":"حَكِيمٌ","page":144,"line":0,"x0":315.46,"x1":373.61,"paths":[]},{"n":35,"text":"عَلِيمࣱ","page":144,"line":0,"x0":299.26,"x1":332.8,"paths":[]}],"mark":{"page":144,"line":0,"x0":89.36,"x1":107.67,"paths":[]},"phrases":[{"from":1,"to":3,"text":{"id":"(Ingatlah) pada hari ketika Dia mengumpulkan mereka semua (dan Allah berfirman)"}},{"from":4,"to":9,"text":{"id":"Wahai golongan jin, kamu telah sering kali (menyesatkan) manusia"}},{"from":10,"to":13,"text":{"id":"Kawan-kawan mereka dari golongan manusia berkata"}},{"from":14,"to":17,"text":{"id":"Ya Tuhan, kami telah saling mendapatkan kesenangan"}},{"from":18,"to":22,"text":{"id":"dan kami telah sampai pada waktu yang telah Engkau tentukan buat kami"}},{"from":23,"to":27,"text":{"id":"Allah berfirman, Nerakalah tempat kamu selama-lamanya"}},{"from":28,"to":31,"text":{"id":"kecuali jika Allah menghendaki lain"}},{"from":32,"to":35,"text":{"id":"Sesungguhnya Tuhanmu Maha Bijaksana lagi Maha Mengetahui"}}],"full":{"id":"(Ingatlah) pada hari ketika Dia mengumpulkan mereka semua (dan Allah berfirman), “Wahai golongan jin, kamu telah sering kali (menyesatkan) manusia.” Kawan-kawan mereka dari golongan manusia berkata, “Ya Tuhan, kami telah saling mendapatkan kesenangan dan kami telah sampai pada waktu yang telah Engkau tentukan buat kami.” Allah berfirman, “Nerakalah tempat kamu selama-lamanya, kecuali jika Allah menghendaki lain.” Sesungguhnya Tuhanmu Maha Bijaksana lagi Maha Mengetahui."},"source":"kemenag-2019-adapted","reviewed":false}