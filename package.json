{
  "name": "quran-terjemah",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data && npm run build:site",
    "build:site": "npm run typecheck && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build:site && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "better-auth": "^1.7.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "pdfjs-dist": "5.4.149",
    "svg-path-bbox": "^2.1.0",
    "svgpath": "^2.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
}
